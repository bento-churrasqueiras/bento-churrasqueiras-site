{
  "redirects": [
    {
      "source": "/produtos-old/smartgrill(/.*)?",
      "destination": "/smartgrill/",
      "permanent": true
    },
    {
      "source": "/produtos-old/duragrill(/.*)?",
      "destination": "/duragrill/",
      "permanent": true
    },
    {
      "source": "/produtos-old(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/produtos/:linha(smartgrill|duragrill|elevatto)(/.*)?",
      "destination": "/:linha/",
      "permanent": true
    },
    {
      "source": "/produtos/:item(grelhas?|grelha-[^/]*|parrilla[^/]*)(/.*)?",
      "destination": "/grelhas/",
      "permanent": true
    },
    {
      "source": "/produtos/:item(bifeiras?|cooktops?|bifeiras-e-cooktops|espetos?|espeto-[^/]*|costelao|acessorios)(/.*)?",
      "destination": "/acessorios/",
      "permanent": true
    },
    {
      "source": "/produtos/:item(suporte-de-fundo|espetos-suspensos)(/.*)?",
      "destination": "/:item/",
      "permanent": true
    },
    {
      "source": "/produtos/(.+)",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/:pagina(catalogo-de-produtos|catalogo|configurator|monte-sua-churrasqueira)(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/churrasqueiras-rotativas-em-garibaldi(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/:pagina(quem-somos|sobre|sobre-nos|a-empresa)(/.*)?",
      "destination": "/empresa/",
      "permanent": true
    },
    {
      "source": "/:pagina(fale-conosco|contatos)(/.*)?",
      "destination": "/contato/",
      "permanent": true
    },
    {
      "source": "/:pagina(assistencia-tecnica|suporte|garantia|manuais)(/.*)?",
      "destination": "/assistencia/",
      "permanent": true
    },
    {
      "source": "/:pagina(galeria|portfolio|obras)(/.*)?",
      "destination": "/projetos/",
      "permanent": true
    },
    {
      "source": "/:pagina(blog|tags|tag|category|categoria|author|feed)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:post(pontos-da-carne-para-churrasco|dicas-para-seu-churrasco-ficar-ainda-melhor)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:pagina(loja|minha-conta|finalizar-compra|carrinho|backup|teste-formulario|404-2|lp-v1|lp-google|home)(/.*)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fontes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|og|marca|icones)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
