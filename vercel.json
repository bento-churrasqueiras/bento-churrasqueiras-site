{
  "redirects": [
    {
      "source": "/produtos-old/smartgrill(/.*)?",
      "destination": "/smartgrill/",
      "permanent": true
    },
    {
      "source": "/produtos-old/duragrill(/.*)?",
      "destination": "/duragrill/",
      "permanent": true
    },
    {
      "source": "/produtos-old(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/produtos/:linha(smartgrill|duragrill|elevatto)(/.*)?",
      "destination": "/:linha/",
      "permanent": true
    },
    {
      "source": "/produtos/:item(grelhas?|grelha-[^/]*|parrilla[^/]*)(/.*)?",
      "destination": "/grelhas/",
      "permanent": true
    },
    {
      "source": "/produtos/:item(bifeiras?|cooktops?|bifeiras-e-cooktops|espetos?|espeto-[^/]*|costelao|acessorios)(/.*)?",
      "destination": "/acessorios/",
      "permanent": true
    },
    {
      "source": "/produtos/:item(suporte-de-fundo|espetos-suspensos)(/.*)?",
      "destination": "/:item/",
      "permanent": true
    },
    {
      "source": "/produtos/(.+)",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/:pagina(catalogo-de-produtos|catalogo|configurator|monte-sua-churrasqueira)(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/churrasqueiras-rotativas-em-garibaldi(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/:pagina(quem-somos|sobre|sobre-nos|a-empresa)(/.*)?",
      "destination": "/empresa/",
      "permanent": true
    },
    {
      "source": "/:pagina(fale-conosco|contatos)(/.*)?",
      "destination": "/contato/",
      "permanent": true
    },
    {
      "source": "/:pagina(assistencia-tecnica|suporte|garantia|manuais)(/.*)?",
      "destination": "/assistencia/",
      "permanent": true
    },
    {
      "source": "/:pagina(galeria|portfolio|obras)(/.*)?",
      "destination": "/projetos/",
      "permanent": true
    },
    {
      "source": "/:pagina(blog|tags|tag|category|categoria|author|feed)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:post(pontos-da-carne-para-churrasco|dicas-para-seu-churrasco-ficar-ainda-melhor)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:pagina(loja|minha-conta|finalizar-compra|carrinho|backup|teste-formulario|404-2|lp-v1|lp-google|home)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/produto/:item(nova-smartgrill[^/]*|g-smart-grill[^/]*|churrasqueiras-linha-g-smart[^/]*)(/.*)?",
      "destination": "/smartgrill/",
      "permanent": true
    },
    {
      "source": "/produto/:item(grelha[^/]*)(/.*)?",
      "destination": "/grelhas/",
      "permanent": true
    },
    {
      "source": "/produto/:item(espeto[^/]*|bifeira[^/]*|chapa[^/]*|acendedor[^/]*|acessorio[^/]*|chaira[^/]*)(/.*)?",
      "destination": "/acessorios/",
      "permanent": true
    },
    {
      "source": "/produto(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/:pagina(produtos|lista-produtos|planta).php",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/plantas(/.*)?",
      "destination": "/produtos/",
      "permanent": true
    },
    {
      "source": "/:pagina(contato|orcamento).php",
      "destination": "/contato/",
      "permanent": true
    },
    {
      "source": "/:pagina(onde-encontrar|seja-representante)(/.*)?",
      "destination": "/contato/",
      "permanent": true
    },
    {
      "source": "/empresa.php",
      "destination": "/empresa/",
      "permanent": true
    },
    {
      "source": "/:pagina(privacidade).php",
      "destination": "/politica-de-privacidade/",
      "permanent": true
    },
    {
      "source": "/projetos.php",
      "destination": "/projetos/",
      "permanent": true
    },
    {
      "source": "/projetos-videos(/.*)?",
      "destination": "/projetos/",
      "permanent": true
    },
    {
      "source": "/:pagina(index|index.php|novidades|novidades.php)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/novidades(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:pagina(assistencia|contato|projetos)-old(/.*)?",
      "destination": "/:pagina/",
      "permanent": true
    },
    {
      "source": "/:pagina(categorias|depoimento|depoimentos|2020|2021|2022|2023|2024)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:post(bento-churrasqueiras-qualidade-tecnologia|bento-churrasqueiras-sobmedida|erros-que-estragam-o-churrasco-saiba-o-que-nao-fazer|churrasqueiras-rotativas-em-bento-goncalves)(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bifeiras-de-sobrepor-inox-304(/.*)?",
      "destination": "/acessorios/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fontes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|og|marca|icones)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
